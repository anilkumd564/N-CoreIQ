APP_ENV=local
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# SAP Connection Mode
# Preferred (Phase 2+):  odata   — SAP Gateway OData V2 over HTTPS
# Legacy/optional:       local   — PyRFC / SAP NetWeaver RFC SDK (direct RFC)
# Future:                btp     — BTP Destination / Cloud Connector
# ---------------------------------------------------------------------------
SAP_CONNECTION_MODE=odata
SAP_DESTINATION_NAME=ECC_DEV

# ---------------------------------------------------------------------------
# OData V2 — SAP Gateway connectivity (SAP_CONNECTION_MODE=odata)
# Environment variables use double-underscore nesting (SAP_ODATA__<FIELD>).
# Do not commit real credentials. Add real values only to .env (gitignored).
# ---------------------------------------------------------------------------
SAP_ODATA__BASE_URL=https://your-sap-host:44300
SAP_ODATA__SERVICE=ZNCOREIQ_REPO_SRV
SAP_ODATA__CLIENT=800
SAP_ODATA__USER=
SAP_ODATA__PASSWORD=
SAP_ODATA__TIMEOUT=30
# Optional: path to a corporate CA bundle PEM file (for internal SAP certs)
SAP_ODATA__CA_BUNDLE=
# Set to true if the SAP Gateway cert CN uses a short hostname (e.g. CN=HYDRSAPT02)
# but you connect via the FQDN.  Chain/trust verification remains enforced.
SAP_ODATA__SKIP_HOSTNAME_CHECK=false
# DEV ONLY — disable ALL TLS verification (self-signed / internal CA with no AIA).
# NEVER set to true in production. Default: false.
SAP_ODATA__SKIP_TLS_VERIFY=false

# ---------------------------------------------------------------------------
# Local RFC — PyRFC / SAP NetWeaver RFC SDK (SAP_CONNECTION_MODE=local)
# Requires the proprietary SAP NW RFC SDK to be installed separately.
# Do not commit real credentials.
# ---------------------------------------------------------------------------
SAP_LOCAL__HOST=
SAP_LOCAL__SYSTEM_NUMBER=00
SAP_LOCAL__CLIENT=100
SAP_LOCAL__USER=
SAP_LOCAL__PASSWORD=
SAP_LOCAL__LANGUAGE=EN

EXPORT_MODE=zip
LOCAL_EXPORT_ROOT=./exports
AUTH_MODE=disabled

# ---------------------------------------------------------------------------
# MCP Server Transport
# stdio           — local / IDE / Claude Desktop (default)
# streamable_http — BTP / remote MCP clients (requires uvicorn)
#
# Local streamable HTTP test:
#   NCOREIQ_MCP_TRANSPORT=streamable_http uvicorn app.main:app --host 127.0.0.1 --port 8000
#   Canonical MCP endpoint: POST http://127.0.0.1:8000/mcp/
#
# BTP deployment sets this via manifest.yml / mta.yaml env properties.
# ---------------------------------------------------------------------------
NCOREIQ_MCP_TRANSPORT=stdio

# ---------------------------------------------------------------------------
# MCP-specific authentication override — TEST/DEMO ONLY.
# xsuaa (default) — /mcp/* requires a valid XSUAA Bearer token, identical to
#                    the global AUTH_MODE=xsuaa behavior.
# none             — /mcp, /mcp/, and /mcp/* bypass JWT validation entirely
#                    (anonymous). AUTH_MODE is NOT changed — /api/v1/* and all
#                    other routes remain XSUAA protected. Intended only for
#                    controlled TEST/DEMO deployments.
# ---------------------------------------------------------------------------
NCOREIQ_MCP_AUTH_MODE=xsuaa

# Return plain JSON instead of SSE per request (recommended with stateless_http).
# Change to false only if your MCP client requires SSE framing.
NCOREIQ_MCP_JSON_RESPONSE=true

# DNS rebinding protection — comma-separated Host header values to allow.
# Leave empty to disable (default; safe behind BTP CF routing layer).
# Local dev example: NCOREIQ_MCP_ALLOWED_HOSTS=["localhost:8000","127.0.0.1:8000"]
NCOREIQ_MCP_ALLOWED_HOSTS=[]
