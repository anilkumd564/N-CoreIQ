APP_ENV=local
LOG_LEVEL=INFO
SAP_CONNECTION_MODE=local
SAP_DESTINATION_NAME=ECC_DEV

# Local development only. Do not commit real credentials.
SAP_LOCAL__HOST=
SAP_LOCAL__SYSTEM_NUMBER=00
SAP_LOCAL__CLIENT=100
SAP_LOCAL__USER=
SAP_LOCAL__PASSWORD=
SAP_LOCAL__LANGUAGE=EN

EXPORT_MODE=zip
LOCAL_EXPORT_ROOT=./exports
AUTH_MODE=disabled
